{
  "name": "mend-workbench",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:browser:list": "playwright test --list",
    "test:browser:report": "playwright show-report",
    "predev": "node scripts/prepare-proof-manifest.mjs",
    "predev:https": "node scripts/prepare-proof-manifest.mjs",
    "prebuild": "node scripts/prepare-proof-manifest.mjs",
    "pretest": "node scripts/prepare-proof-manifest.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.1",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module"
}

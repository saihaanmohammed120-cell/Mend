# This file contains no credentials. Copy to .env privately; never commit .env.
MEND_MODE=database_only
MEND_LIVE_ENABLED=false
# API requires a genuine Supabase auth configuration and HTTPS public origin.
MEND_PUBLIC_ORIGIN=
MEND_ALLOWED_ORIGINS=
SUPABASE_URL=https://uwkdrmdflzverflcfkgk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Generate 32 random bytes, URL-safe base64 encode; keep private.
MEND_SESSION_SEAL_KEY=
# Server services only. Never inject these into the generated-code runner.
NEBIUS_TOKEN_FACTORY_API_KEY=
NEBIUS_TOKEN_FACTORY_URL=https://api.tokenfactory.nebius.com
NEBIUS_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
NEBIUS_IAM_TOKEN=
NEBIUS_PROJECT_ID=
NEBIUS_SUBNET_ID=
NEBIUS_PLATFORM=
NEBIUS_PRESET=
MEND_RUNNER_IMAGE_DIGEST=
# Shared local test-store paths used by the bootstrap/worker entry points.
MEND_LOCAL_DATABASE=/var/lib/mend/tasks.sqlite3
MEND_LOCAL_ARTIFACT_ROOT=/var/lib/mend/artifacts
# Real prices must come with source/date provenance; blank values are unconfigured.
MEND_INPUT_PRICE_PER_MILLION=
MEND_OUTPUT_PRICE_PER_MILLION=
MEND_PRICE_PROVENANCE=
# Real configured task ceiling; no monetary amount is invented. Required for provider spike.
MEND_TASK_COST_CAP=
# Live integration is blocked: trusted report transport,
# configured price provenance and reviewed safety evidence still need wiring.
# Changing flags does not supply verified reports or provider safety evidence.

# Optional provider spike only: fixed trusted probe image and explicit approval.
MEND_SPIKE_IMAGE=
MEND_SPIKE_PROBE_APPROVED=false
